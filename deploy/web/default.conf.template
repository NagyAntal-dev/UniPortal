# ============================================================================
# UniPortal web — a statikus felület, és UGYANAZON a címen a Supabase API
# (auth, rest, graphql, realtime, storage, functions) továbbítása az api-gw
# felé. Így a böngésző egyetlen címet lát: nincs CORS, és elég egy port/TLS.
# A ${API_GW_UPSTREAM} értéket az nginx-kép indításkor helyettesíti.
# ============================================================================
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
# Külső TLS-proxy mögött az eredeti protokollt adjuk tovább.
map $http_x_forwarded_proto $fwd_proto { default $http_x_forwarded_proto; '' $scheme; }

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    # A Docker belső DNS-e: az api-gw újraindulás után is feloldható marad.
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $api_gw http://${API_GW_UPSTREAM};

    client_max_body_size 50m;
    large_client_header_buffers 4 16k;
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    include /etc/nginx/uniportal/headers.conf;

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }

    # A futásidejű beállítás és az oldalak mindig frissek legyenek.
    location = /config.js { include /etc/nginx/uniportal/headers.conf; add_header Cache-Control "no-store" always; }
    location ~* \.html$   { include /etc/nginx/uniportal/headers.conf; add_header Cache-Control "no-cache" always; }
    location = /          { include /etc/nginx/uniportal/headers.conf; add_header Cache-Control "no-cache" always; try_files /index.html =404; }
    # A bundle verziójellel (?v=…) töltődik, ezért hosszan cache-elhető.
    location = /app.bundle.js { include /etc/nginx/uniportal/headers.conf; add_header Cache-Control "public, max-age=604800" always; }

    # ---- Supabase API ----
    location /auth/v1/      { include /etc/nginx/uniportal/proxy.conf; proxy_pass $api_gw; }
    location /rest/v1/      { include /etc/nginx/uniportal/proxy.conf; proxy_pass $api_gw; }
    location /graphql/v1/   { include /etc/nginx/uniportal/proxy.conf; proxy_pass $api_gw; }
    location /functions/v1/ { include /etc/nginx/uniportal/proxy.conf; proxy_pass $api_gw; }
    location /realtime/v1/ {
        include /etc/nginx/uniportal/proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_pass $api_gw;
    }
    location /storage/v1/ {
        include /etc/nginx/uniportal/proxy.conf;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 50m;
        proxy_pass $api_gw;
    }

    location / { try_files $uri =404; }
}
