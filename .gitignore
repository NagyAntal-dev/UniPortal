# app.bundle.js IS committed on purpose: GitHub Pages serves this branch
# directly (no CI build step), so the built bundle has to be in the tree.
# Regenerate it with `npm run build` after every change to app.jsx or features/.
# Switching Pages to the ci/github-pages.yml workflow makes it a build artifact
# again — see README, "Automatikus build".
.app.build.tsx

node_modules/

# Source admissions documents contain real personal data (passport numbers,
# bank details). They must never reach a public repo or Pages site.
*.docx
*.pdf

.DS_Store
*.log

# ---- Docker-telepítés (DEPLOY.md) ----
# A titkokat tartalmazó .env SOHA nem kerülhet a tárolóba (nyilvános).
.env
.env.tmp*
# Az önálló Supabase adatai és a mentések a szerveren maradnak.
deploy/supabase/volumes/db/data/
deploy/supabase/volumes/storage/
backups/

# Local enrollment imports contain personal data and account credentials.
private-imports/
NJE kurzusfelvételek*.xlsx
tools/__pycache__/
